# ──────────────────────────────────────────────────────────────────────
# Universum Labs — environment configuration
# Copy to .env.local and fill in real values. Never commit .env.local.
# Every integration degrades gracefully when its variables are absent:
# forms report honestly that they are not yet connected, and the
# Insights section shows its "coming soon" state.
# ──────────────────────────────────────────────────────────────────────

# ── Site ──────────────────────────────────────────────────────────────
# Canonical public URL of this website (no trailing slash).
# Used for metadata, Open Graph URLs, sitemap and structured data.
# On Vercel this can stay unset: the site falls back to the deployment's
# production domain (VERCEL_PROJECT_PRODUCTION_URL) automatically.
# Set it once a real domain exists, e.g. https://www.universumlabs.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Application (login / dashboard / graph) ───────────────────────────
# The Universum Labs platform lives in a separate application. Point
# these at its deployed URL once it exists. While unset, "Log In" links
# resolve to this site's /login page, which explains early access.
# NEXT_PUBLIC_APP_URL=https://app.universumlabs.com
# NEXT_PUBLIC_APP_LOGIN_URL=https://app.universumlabs.com/login

# ── Form submissions (early access + contact) ─────────────────────────
# Configure either destination below, or both. A submission counts as
# received when at least one of them accepts it.

# RECOMMENDED: Google Sheet. Each submission becomes a row, and you get
# an email notification. No DNS setup needed.
# Setup: docs/BETA_SIGNUPS_SETUP.md
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=

# The PUBLIC contact address shown on the site (footer, contact page,
# and form-failure messages). Must be a mailbox that actually exists.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@universumlabs.com

# OPTIONAL: SMTP email delivery. Any transactional email provider with
# SMTP works (Resend, Postmark, SES, Mailgun...). Requires verifying a
# sending domain. Setup: docs/EMAIL_AND_NEWSLETTER_SETUP.md
INQUIRY_TO_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Address used in the From header — most providers require a verified sender.
SMTP_FROM=
# Set to "true" only for implicit TLS (usually port 465).
SMTP_SECURE=false

# ── Beehiiv newsletter ────────────────────────────────────────────────
# Create an API key at https://app.beehiiv.com → Settings → API.
# The publication ID starts with "pub_". Server-side only — never
# exposed to the browser.
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# ── Headless WordPress (Insights) ─────────────────────────────────────
# Base URL of the WordPress installation (no trailing slash, no /wp-json).
# See docs/WORDPRESS_SETUP.md for full provisioning instructions.
# WORDPRESS_API_URL=https://cms.universumlabs.com
