# ──────────────────────────────────────────────────────────────────────
# Universum Labs — environment configuration
# Copy to .env.local and fill in real values. Never commit .env.local.
# Every integration degrades gracefully when its variables are absent:
# forms report honestly that they are not yet connected, and the
# Insights section shows its "coming soon" state.
# ──────────────────────────────────────────────────────────────────────

# ── Site ──────────────────────────────────────────────────────────────
# Canonical public URL of this website (no trailing slash).
# Used for metadata, Open Graph URLs, sitemap and structured data.
# Example for production: https://www.universumlabs.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Application (login / dashboard / graph) ───────────────────────────
# The Universum Labs platform lives in a separate application. Point
# these at its deployed URL once it exists. While unset, "Log In" links
# resolve to this site's /login page, which explains early access.
# NEXT_PUBLIC_APP_URL=https://app.universumlabs.com
# NEXT_PUBLIC_APP_LOGIN_URL=https://app.universumlabs.com/login

# ── Inquiry email (contact + partnership + pilot forms) ───────────────
# Where form submissions are delivered.
INQUIRY_TO_EMAIL=hello@universumlabs.com

# SMTP transport used to send inquiry email. Any transactional email
# provider with SMTP support works (Postmark, Resend, SES, Mailgun...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Address used in the From header — most providers require a verified sender.
SMTP_FROM=
# Set to "true" only for implicit TLS (usually port 465).
SMTP_SECURE=false

# ── Beehiiv newsletter ────────────────────────────────────────────────
# Create an API key at https://app.beehiiv.com → Settings → API.
# The publication ID starts with "pub_". Server-side only — never
# exposed to the browser.
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# ── Headless WordPress (Insights) ─────────────────────────────────────
# Base URL of the WordPress installation (no trailing slash, no /wp-json).
# See docs/WORDPRESS_SETUP.md for full provisioning instructions.
# WORDPRESS_API_URL=https://cms.universumlabs.com
